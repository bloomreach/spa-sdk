{
  "name": "@bloomreach/example-vue",
  "version": "28.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "serve dist -sn -p 3006",
    "dev": "vite --port 3006",
    "build": "pnpm run type-check && pnpm run build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit --composite false",
    "type-check:watch": "npm run type-check -- --watch"
  },
  "dependencies": {
    "@bloomreach/spa-sdk": "28.2.0",
    "@bloomreach/vue-sdk": "28.2.0",
    "axios": "1.20.0",
    "sanitize-html": "2.18.0",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "20.17.9",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/tsconfig": "0.9.1",
    "serve": "14.2.6",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vite-plugin-node-polyfills": "0.28.0",
    "vue-tsc": "3.3.12"
  }
}

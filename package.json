{
  "private": true,
  "description": "Bloomreach SPA SDK",
  "name": "spa-sdk-workspace",
  "type": "module",
  "keywords": [
    "bloomreach",
    "spa",
    "sdk"
  ],
  "engines": {
    "node": ">=20.19.0",
    "pnpm": "^8.0.0"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "> 0.5%"
  ],
  "author": "Bloomreach B.V.",
  "license": "Apache-2.0",
  "homepage": "https://www.bloomreach.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bloomreach/spa-sdk"
  },
  "bugs": {
    "url": "https://bloomreach.atlassian.net/projects/SPASDK/issues"
  },
  "scripts": {
    "audit": "pnpm -r --stream audit --prod --audit-level=critical",
    "build": "pnpm -r --stream build",
    "dev": "pnpm -r --parallel --filter @bloomreach/${SDK_NAME:-*}-sdk run dev",
    "lint": "pnpm -r --workspace-concurrency=1 lint",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "bump": "pnpm changeset && pnpm changeset version && pnpm install && pnpm postbump",
    "postbump": "pnpm changelog",
    "changelog": "auto-changelog --latest-version $(pnpm pkg get version -C ./packages/spa-sdk)",
    "typedoc": "pnpm -F spa-sdk typedoc",
    "deploy-to-heroku": "./scripts/deploy_heroku_app.sh ${0} ${1} ${2}",
    "heroku-postbuild": "pnpm build && cd ${PROJECT_PATH:-.}",
    "release": "pnpm publish -r --filter \"./packages/**\" --no-git-checks"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "auto-changelog": "2.7.0",
    "glob": "10.5.0",
    "heroku": "11.11.0",
    "npx": "10.2.2"
  },
  "auto-changelog": {
    "hideCredit": true,
    "commitLimit": false,
    "tagPrefix": "spa-sdk-",
    "appendGitLog": "--since 2021-05-10",
    "hideEmptyReleases": true,
    "remote": "github",
    "issueUrl": "https://bloomreach.atlassian.net/browse/{id}",
    "issuePattern": "^[A-Z]+-\\d+",
    "mergeUrl": "https://code.bloomreach.com/engineering/xm/spa-sdk/-/merge_requests/{id}"
  },
  "packageManager": "pnpm@8.15.8",
  "pnpm": {
    "overrides": {
      "@babel/runtime@7": "7.29.10",
      "@hono/node-server@1": "1.19.17",
      "@humanfs/node@0.16": "0.16.8",
      "@sigstore/core@3": "3.2.1",
      "@sigstore/verify@3": "3.1.1",
      "@xmldom/xmldom@0.8": "0.8.15",
      "ajv@6": "6.15.0",
      "ajv@8": "8.20.0",
      "baseline-browser-mapping@2": "2.11.27",
      "bn.js@4": "4.12.5",
      "bn.js@5": "5.2.5",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "browserslist@4": "4.29.3",
      "cipher-base": "1.0.7",
      "colord@2": "2.10.0",
      "compression@1": "1.8.2",
      "cross-spawn@7": "7.0.6",
      "elliptic": "6.6.1",
      "eslint-plugin-react": "7.34.2",
      "fast-uri@3": "3.1.8",
      "flatted@3": "3.4.4",
      "form-data@3": "3.0.5",
      "form-data@4": "4.0.6",
      "glob@10": "10.5.0",
      "handlebars": "4.7.10",
      "hono@4": "4.13.13",
      "http-cache-semantics@4": "4.3.0",
      "http-proxy-middleware@2": "2.0.10",
      "immutable@5": "5.1.9",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "jsonpath@1": "1.3.0",
      "launch-editor@2": "2.14.2",
      "lodash@4": "4.18.1",
      "mdast-util-to-hast@13": "13.2.1",
      "minimatch@3": "3.1.5",
      "minimatch@5": "5.1.9",
      "minimatch@9": "9.0.9",
      "nanoid@3": "3.3.20",
      "path-to-regexp@8": "8.4.2",
      "pbkdf2": "3.1.7",
      "phoenix@1": "1.8.15",
      "picomatch@2": "2.3.1",
      "picomatch@4": "4.0.7",
      "piscina@5": "5.3.2",
      "postcss@8": "8.5.29",
      "proxy-addr@2": "2.0.8",
      "rollup@4": "4.59.0",
      "sha.js": "2.4.12",
      "shell-quote": "1.12.0",
      "sigstore@4": "4.1.1",
      "source-map-js@1": "1.2.2",
      "svgo@2": "2.8.4",
      "tar@7": "7.5.22",
      "underscore@1": "1.13.8",
      "webpack@5": "5.111.1",
      "websocket-driver": "0.7.5",
      "ws@6": "6.2.6",
      "ws@7": "7.5.13",
      "ws@8": "8.22.0",
      "yaml@1": "1.10.3",
      "yaml@2": "2.9.1"
    }
  }
}
